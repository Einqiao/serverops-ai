dmp:
  base_url: "http://127.0.0.1:8080"
  # Prefer DMP_TOKEN or DMP_USERNAME/DMP_PASSWORD environment variables.
  username: ""
  password: ""
  token: ""
  timeout_seconds: 10
monitor:
  room_id: ""
  poll_interval: 60
  log_lines: 200

threshold:
  cpu: 90
  memory: 90
  disk: 90

llm:
  enabled: true
  provider: "siliconflow"
  base_url: "https://api.siliconflow.cn/v1"
  model: "deepseek-ai/DeepSeek-R1-0528-Qwen3-8B"
  api_key_env: "SILICONFLOW_API_KEY"
  timeout: 30

storage:
  database_path: "data/serverops.db"

webhook:
  enabled: false
  host: "0.0.0.0"
  port: 8081
  secret: ""
  verification_enabled: true
